# Environment: Development
# Description: Environment variables used by `npm run dev`.

# VITE_VEYGO_API_URL is the base URL of the Veygo RESTful API (Fake API served by json-server in Sprint 2).
VITE_VEYGO_API_URL="http://localhost:3000/api/v1"
# Endpoint paths of the Veygo RESTful API.
VITE_USERS_ENDPOINT_PATH="/users"
VITE_VEHICLES_ENDPOINT_PATH="/vehicles"
VITE_BOOKINGS_ENDPOINT_PATH="/bookings"
VITE_FAVORITES_ENDPOINT_PATH="/favorites"
VITE_BLOCKED_DATES_ENDPOINT_PATH="/blockedDates"
VITE_REVIEWS_ENDPOINT_PATH="/reviews"
VITE_CONVERSATIONS_ENDPOINT_PATH="/conversations"
VITE_MESSAGES_ENDPOINT_PATH="/messages"
VITE_NOTIFICATIONS_ENDPOINT_PATH="/notifications"
# VITE_MAP_TILES_URL is the tile server of the external map service (OpenStreetMap).
VITE_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# VITE_PRIME_UI_LICENSE_KEY (PrimeUI license key) must be defined in .env.local, which is not committed.
